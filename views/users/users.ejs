<%- include('../../templates/header.ejs') %>

<div class="[height:700px] flex flex-col items-center justify-center" id="users-page">
    <h1 class="text-3xl text-center font-extrabold my-10"><%= title %> page</h1>

    <div class="flex flex-col text-lg items-center justify-center">
        <% if(users){ %>
            <% users.forEach((user)=>{%>
                <div class="my-2">
                    <span class="mx-2">id:<%=user.userId%></span>
                    <span class="mx-2">Firstname:<%= user.firstName %></span>
                     <span class="mx-2">Lastname:<%= user.lastName %></span>
                      <span class="mx-2">email:<%= user.email %></span>
                      
                </div>
                <br/>
            <% })%>
        <%}%>
    </div>

   
</div>

<%- include('../../templates/footer.ejs') %>