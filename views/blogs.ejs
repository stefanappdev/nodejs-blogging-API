<%- include('../templates/header.ejs') %>
<div class="[height:700px] flex flex-col items-center justify-center" id="profile-page">
    <h1 class="text-3xl text-center font-extrabold "> <%= user %> 's blogs</h1>

<div class="my-2 flex flex-col items-center justify-center" id="blogs">
    
    <% if (blogs.length!==0) { %>
    <% blogs.forEach ( (blog) => { %>
    <li>
       Subject: <span class="font-bold text-lg"> <%= blog.blog_subject %> </span>
        <br/>
        <a href="/blogs/<%= user %>/<%= blog.blog_id%>"> show more </a>
    
    </li>
    <br/>
    <% })%>
    <% } else {%>
        <div>No blogs found</div>
    <%}%>
    <div class="inline-flex mt-10 justify-center items-center">
         <a class="mr-10" href="/users/<%= user %>/profile">back to profile</a>
         <a class="" href="/blogs/<%= user %>/postblogs"> post a new blog</a>
    </div>
  
    
</div>
</div>
<%- include('../templates/footer.ejs') %>