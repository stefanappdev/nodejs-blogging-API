<%- include('../templates/header.ejs') %>

<div class="[height:700px] flex flex-col items-center justify-center" id="login-page">
    <h1 class="text-3xl text-center font-extrabold my-10">Login To start Blogging!</h1>

    <form 
    id="login-form" 
    class=
    "bg-neutral-300 text-neutral-900
     w-80 h-100 rounded-md text-lg
     flex flex-col items-center px-3  justify-center">

     <label class=" h-10 font-bold" aria-labelledby="username" for="username">username:</label>
     <input 
     aria-placeholder="Enter your username" 
     placeholder="Enter your username"
     id="username"
     type="text"
     class="font-semibold focus:bg-blue-100"
     required
     />

    <br/>

     <label class='h-10 font-bold ' aria-labelledby="password" for="password">password:</label>
     <input 
     aria-placeholder="Enter your password" 
     placeholder="Enter your password"
     id="password"
     type="password"
    class="font-semibold focus:bg-blue-100"
    required 
    />
    <br/>
     <button class="h-12 w-20 font-bold bg-green-700 text-stone-200 rounded-sm" type="submit">submit</button>

    </form>
</div>

<script>
    function handleSubmit(event){
        event.preventDefault();

                let username=event.target.username.value;
                let password=event.target.password.value;

                /*
                const checkUsersOnLogin=async()=>{
                    await fetch('http://localhost:8000/users')
                    .then(response=>response.json())
                    .then(data=>{
                        let users=data;
                        let matchedUser=users.find(user=>{
                            if(user.username===username&&user.password===password){
                                return user
                            }
                        })

                        if(matchedUser){
                            alert("Login sucessful")
                            window.location.replace("/")
                        }else{
                            alert("Your password or username is incorrect")
                        }

                    })
                }

        checkUsersOnLogin()/*/

        const login=async()=>{
            let options={
                
                
                method:'POST',
                body:JSON.stringify({
                    username:username,
                    password:password
                }),
                headers:{
                    "Content-Type":"application/json"
                }
            }

            await fetch('http://localhost:8000/login',options)
            .then(resp=>resp.json())
            .then(data=>{
                if(data.status===401){
                    alert(data.msg)
                }else if(data.status===200){
                    alert(data.msg)
                    window.location.replace('/')
                }
            })
        }



        try{
            login()
        }catch(error){
            console.log(error)
        }


            
    }


   

    document.querySelector("#login-form").addEventListener('submit',handleSubmit)
</script>

