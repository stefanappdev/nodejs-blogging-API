<%- include('../templates/header.ejs') %>

<div class="[height:700px] flex flex-col items-center justify-center" id="login-page">
    <h1 class="text-3xl text-center font-extrabold my-10">Login To start Blogging!</h1>

    <form 
    id="login-form" 
    class=
    "bg-neutral-300 text-neutral-900
     w-80 h-100 rounded-md text-lg
     flex flex-col items-center px-3  justify-center">

     <label class=" h-10 font-bold" aria-labelledby="email" for="email">email:</label>
     <input 
     aria-placeholder="Enter your email" 
     placeholder="Enter your email"
     id="email"
     type="text"
     class="font-semibold focus:bg-blue-100"
     required
     />

    <br/>

     <label class='h-10 font-bold ' aria-labelledby="password" for="password">password:</label>
     <input 
     aria-placeholder="Enter your password" 
     placeholder="Enter your password"
     id="password"
     type="password"
    class="font-semibold focus:bg-blue-100"
    required 
    />
    <br/>
     <button class="h-12 w-20 font-bold bg-green-700 text-stone-200 rounded-sm" type="submit">submit</button>

    </form>
</div>

<script>
    function handleSubmit(event){
        event.preventDefault();
        const fetchUsers=async(url)=>await fetch(url);
        try{
            fetchUsers('http://localhost:8000/admin/users')
            .then(async(Response)=>{
                let USERS= await Response.json();
               
                let email=event.target.email.value;
                let password=event.target.password.value;
                let matchingUser=USERS.find(user=>{
                    if(user.email===email && user.password===password){
                        return user
                    }
                })
                
                if(matchingUser){
                    alert('Login was sucessful')
                    window.location.replace('/')
                }



            }) 
        }catch(err){
            console.log(err)
        }
        
    }


    document.querySelector("#login-form").addEventListener('submit',handleSubmit)
</script>

<%- include('../templates/footer.ejs') %>