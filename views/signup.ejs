<%- include('../templates/header.ejs') %>

<div class="[height:700px] flex flex-col items-center justify-center" id="signup-page">
    <h1 class="text-3xl text-center font-extrabold my-10">Sign into your profile</h1>

    <form id="signup-form" 
    class=
    "bg-neutral-300 text-neutral-900
     w-80 h-105 p-4 rounded-md text-lg
     flex flex-col items-center px-3  justify-center">

    
     <label class='h-10 font-bold ' aria-labelledby="firstName" for="firstName">Firstname:</label>
     <input 
     aria-placeholder="Enter your Firstname" 
     placeholder="Enter your Firstname"
     id="firstName"
     type="text"
    class="font-semibold focus:bg-blue-100"
     />
     <br/>

      <label class='h-10 font-bold ' aria-labelledby="lastName" for="lastName">Lastname:</label>
     <input 
     aria-placeholder="Enter your lastname" 
     placeholder="Enter your lastname"
     id="lastName"
     type="text"
    class="font-semibold focus:bg-blue-100"
     />
     <br/>
    
     <label class=" h-10 font-bold" aria-labelledby="username" for="username">Username:</label>
     <input 
     aria-placeholder="Enter your username" 
     placeholder="Enter your username"
     id="username"
     type="text"
     class="font-semibold focus:bg-blue-100"
     />

    <br/>


     <label class='h-10 font-bold ' aria-labelledby="password" for="password">password:</label>
     <input 
     aria-placeholder="Enter your password" 
     placeholder="Enter your password"
     id="password"
     type="text"
    class="font-semibold focus:bg-blue-100"
     />
    <br/>
     <button class="h-12 w-20 font-bold bg-green-700 text-stone-200 rounded-sm" type="submit">submit</button>

    </form>
</div>

<%- include('../templates/footer.ejs') %>