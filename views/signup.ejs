<%- include('../templates/header.ejs') %>

<div class="[height:700px] flex flex-col items-center justify-center" id="signup-page">
    <h1 class="text-3xl text-center font-extrabold my-10">Sign into your profile</h1>

    <form id="signup-form" 
    class=
    "bg-neutral-300 text-neutral-900
     w-80 h-105 p-4 rounded-md text-lg
     flex flex-col items-center px-3  justify-center">

    
     <label class='h-10 font-bold ' aria-labelledby="username" for="username">username:</label>
     <input 
     aria-placeholder="Enter your username" 
     placeholder="Enter your username"
     name="username"
     id="username"
     type="text"
    class="font-semibold focus:bg-blue-100"
    required
     />
  
    
     <label class=" h-10 font-bold" aria-labelledby="email" for="email">email:</label>
     <input 
     aria-placeholder="Enter your email" 
     placeholder="Enter your email"
     id="email"
     name="email"
     type="email"
     class="font-semibold focus:bg-blue-100"
     required
     />

    <br/>


     <label class='h-10 font-bold ' aria-labelledby="password" for="password">password:</label>
     <input 
     aria-placeholder="Enter your password" 
     placeholder="Enter your password"
     id="password"
     name="password"
     type="password"
    class="font-semibold focus:bg-blue-100"
    required
     />
    <br/>
     <button class="h-12 w-20 font-bold bg-green-700 text-stone-200 rounded-sm" type="submit">submit</button>

    </form>
</div>


<script >

function handleSignup(event){
     event.preventDefault();
       
        try{
           
            let email=event.target.email.value;
            let username=event.target.username.value;
            let password=event.target.password.value;
            
        

          const checkMatchedUser=async()=>{
            await fetch('http://localhost:8000/users')
            .then(response=>response.json())
            .then(users=>{
          
                let matchingUsers=users.find(user=>{
                    if(user.email===email||user.username===username){
                        return user
                    }
                })

                if(matchingUsers){
                    alert('A user with this email or username exists in the database')   
                    return 
                     
                }else{

                    const headers={
                        "Content-Type":"application/json",
                    }
                    const body=JSON.stringify({
                        email,username,password
                    })

                    const options={
                        method:'POST',
                        headers,
                        body
                    }

                    fetch('http://localhost:8000/users',options)
                    .then(response=>{
                        if(response.status===200){
                            alert('new user was added sucessfully')
                            window.location.replace("/")
                        }
                    })
                    
                }
            })
            
        }

      
       
        checkMatchedUser()
            
        }catch(err){
            console.log(err)
        }

       
    }

document.querySelector("#signup-form").addEventListener('submit',handleSignup)
   
</script>

<%- include('../templates/footer.ejs') %>