<%- include('../templates/header.ejs') %>

<div class="[height:700px] flex flex-col items-center justify-center">
   
 

    <h1 class="text-3xl text-center font-extrabold my-10">Post a new blog</h1>


    
    <form 
    id="postBlogForm" 
    class=
    "bg-neutral-300 text-neutral-900
     w-80 h-100 rounded-md text-lg
     flex flex-col items-center px-3  justify-center">

     <span id="user" class="hidden"><%= user %></span>

     <label class=" h-10 font-bold" aria-labelledby="blog_subject" for="blog_subject">subject</label>
     
     <input 
     aria-placeholder="Enter the blog title" 
     id="blog_subject"
     type="text"
     class="font-semibold focus:bg-blue-100"
     value="Enter your title"
     required
     />

    <br/>

     <label class='h-10 font-bold ' aria-labelledby="blog_content" for="blog_content">share your story:</label>
     <textarea 
     aria-placeholder="Share your story" 
     placeholder="share your story" 
     rows="5"
     cols="25"
     id="blog_content"
     type="text"
    class="font-semibold border-stone-700 border-4 focus:bg-blue-100"
    required 
    >
    Enter your story here
    </textarea>
    <br/>
    
    <div class="inline-flex items-center align-center">
    
      <button id="submitBlog"  class="h-12 w-25 mx-5 font-bold bg-green-700 text-stone-200 rounded-sm" >submit</button>
      
   </div>
    

    </form>


       <div class="inline-flex items-center my-2 align-center">
    
      <button id="cancelBlogPost"  class="h-12 w-25 [margin-left:-220px] mt-6 font-bold bg-red-700 text-stone-200 rounded-sm" >back</button>
      
   </div>
</div>

<script>
    function handleSubmit(event){
        event.preventDefault();

                let subject=event.target.blog_subject.value;
                let body=event.target.blog_content.value;
                let user=document.querySelector('#user').textContent
                let datePosted=Date.now()


        const postNewBlog=async()=>{
            let options={
                
                
                method:'POST',
                body:JSON.stringify({
                    blog_subject:subject,
                    blog_content:body,
                    user:user,
                    datePosted:datePosted
                    
                }),
                headers:{
                    "Content-Type":"application/json"
                }
            }

            await fetch(`http://localhost:8000/blogs/${user}`,options)
            .then(resp=>resp.json())
            .then(data=>{
                if(data.status===404){
                    alert(data.msg)
                    window.location.replace(`/blogs/${user}/postblogs`)
                }else if(data.status===200){
                    alert(data.msg)
                    window.location.replace(`/blogs/${user}`)
                }
            })
        }



        try{
            postNewBlog()
        }catch(error){
            console.log(error)
        }


            
    }


   
    document.querySelector('#cancelBlogPost').addEventListener('click',()=>{
        
        let user=document.querySelector('#user').textContent.toString().trim();
        let backLink=`/blogs/${user}`
        window.location.replace(backLink);
        
    })

    document.querySelector("#postBlogForm").addEventListener('submit',handleSubmit)
</script>

<%- include('../templates/footer.ejs') %>